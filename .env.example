GOOGLE_API_KEY=your-gemini-api-key-here
# If analysis hangs at "llm_call_start" or the app shows a quota error, your Gemini free tier may be exhausted.
# Fix: wait for reset, enable billing on the Google Cloud project, or use a key with available quota.
# See: https://ai.google.dev/gemini-api/docs/rate-limits

# LLM behavior: mock | auto | real
#   mock — never calls Gemini (good for CI / demos without a key).
#   auto — default; call Gemini, fall back to deterministic JSON on quota/429/invalid key.
#   real — fail on any LLM error (production-style).
LLM_MODE=auto
# Optional override for GenerativeModel id (default: gemini-2.0-flash in agents/config.py).
# GEMINI_MODEL_ID=gemini-2.0-flash

# LangGraph pipeline typically uses ~2-3 LLM calls per signal (merged detect + plan + notify).
# Optional LangSmith tracing (off by default):
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=

# LangGraph pipeline uses ~2-3 LLM calls per signal (merged detect + plan + notify).
# Optional LangSmith tracing (off by default):
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=

# Host port for FastAPI (container always listens on 8000 inside). Use 8001 if 8000 is taken.
BACKEND_HOST_PORT=8000

# Mobile app → backend (Docker / Expo). Must match BACKEND_HOST_PORT on host.
#
# --- Same computer (browser / simulator) ---
#   Browser:     http://localhost:8081
#   API:         http://localhost:8000
#
# --- Physical phone on same Wi‑Fi (Expo Go) — do NOT use localhost ---
#   Replace 192.168.x.x with your PC LAN IP (hostname -I | awk '{print $1}')
#   Metro QR:    REACT_NATIVE_PACKAGER_HOSTNAME=192.168.x.x  → scan QR in Expo Go
#   API calls:   EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
#   Typing http://localhost:8081 on the phone will NOT work (localhost = the phone).
#
# Restart stack after changing: make down && ./scripts/dev.sh
EXPO_PUBLIC_API_URL=http://localhost:8000
REACT_NATIVE_PACKAGER_HOSTNAME=

# Web Map tab (Expo web): Maps JavaScript API. Restrict this key by HTTP referrer
# (e.g. http://localhost:8081/* and your LAN Expo URL) in Google Cloud Console.
# Falls back to app.json native Maps keys when unset (same key is typical for hackathon demos).
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Optional: real API keys for future sprints
WEATHER_API_KEY=MOCK_WEATHER_KEY
TRAFFIC_API_KEY=MOCK_TRAFFIC_KEY
SOCIAL_API_KEY=MOCK_SOCIAL_KEY

DEBUG=false

# SonarQube Cloud (CLI + MCP)
SONARQUBE_URL=https://sonarcloud.io
SONARQUBE_ORG=danishirfan
SONARQUBE_TOKEN=your-sonarqube-user-token

# Compatibility aliases for scanner/older scripts
SONAR_HOST_URL=${SONARQUBE_URL}
SONAR_ORGANIZATION=${SONARQUBE_ORG}
SONAR_TOKEN=${SONARQUBE_TOKEN}
