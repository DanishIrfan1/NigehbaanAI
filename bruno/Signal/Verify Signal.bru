meta {
  name: Verify False Alarm
  type: http
  seq: 2
}

post {
  url: {{base_url}}/verify/{{signal_id}}
  body: json
  auth: none
}

body:json {
  {
    "field_report": "Actually a broken water main near G-10 markaz, not urban flooding."
  }
}

tests {
  test("Status code is 202", function() {
    expect(res.getStatus()).to.equal(202);
  });
  
  test("Verification status is verifying", function() {
    expect(res.getBody().status).to.equal('verifying');
  });
}
